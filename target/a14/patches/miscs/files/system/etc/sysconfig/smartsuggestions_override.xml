<?xml version="1.0" encoding="utf-8"?>
<config>
    <!-- Prevent SmartSuggestions from starting as ContentCaptureService or via Boot Broadcast to save Keystore -->
    <component-override package="com.samsung.android.smartsuggestions">
        <component class="com.samsung.android.smartsuggestions.extservice.services.ContentCaptureService" enabled="false" />
        <component class="com.samsung.android.smartsuggestions.receiver.BootReceiver" enabled="false" />
    </component-override>

    <!-- Prevent SCS from starting via Boot Broadcast -->
    <component-override package="com.samsung.android.scs">
        <component class="com.samsung.android.scs.receiver.BootReceiver" enabled="false" />
    </component-override>
</config>
